# Ignore operating system, editor, and cache files
.DS_Store
Thumbs.db
.vscode/
.idea/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.venv/
venv/

# Ignore large artifacts by default
models/checkpoints/
reports/figures/generated/

# Keep directory placeholders
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!models/.gitkeep
!reports/figures/.gitkeep

# Ignore public showcase downloads and generated previews
data/external/showcase/
reports/figures/showcase/
reports/public_showcase.md
reports/public_showcase_manifest.json

# Ignore cloned external benchmark repositories
data/external/nasa_microscopy_models/
data/external/ebsd_indexing/
data/external/emps/
data/external/automatic-sem-image-segmentation/
data/external/MudrockNet/
