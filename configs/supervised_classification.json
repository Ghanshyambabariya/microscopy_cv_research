  "num_classes": 3,
  "image_size": 128,
  "batch_size": 32,
  "epochs": 6,
  "learning_rate": 0.0003,
  "weight_decay": 0.0001,
  "seed": 42,
  "save_path": "models/checkpoints/supervised_classification.pt",
  "report_path": "reports/supervised_classification_metrics.json"
}
