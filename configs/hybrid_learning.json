{
  "experiment_name": "microscopy_hybrid_multitask",
  "task_type": "hybrid",
  "dataset_csv": "data/processed/labels.csv",
  "image_root": "data/raw/images",
  "classification_target": "target_class",
  "regression_target": "property_value",
  "group_column": "specimen_id",
  "encoder_name": "resnet18",
  "encoder_source": "torchvision",
  "pretrained": false,
  "freeze_encoder": false,
  "synthetic_mix_ratio": 0.3,
  "consistency_weight": 0.2,
  "classification_weight": 1.0,
  "regression_weight": 1.0,
  "num_classes": 3,
  "image_size": 128,
  "batch_size": 12,
  "epochs": 4,
  "learning_rate": 0.0003,
  "weight_decay": 0.0001,
  "seed": 42,
  "save_path": "models/checkpoints/hybrid.pt",
  "report_path": "reports/hybrid_metrics.json"
}
